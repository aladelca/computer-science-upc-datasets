WEEK3_REDESIGN_ENABLED=1
WEEK3_REDESIGN_PROVIDER=openai
WEEK3_REDESIGN_MODEL=gpt-image-1.5
WEEK3_REDESIGN_DRY_RUN=0
WEEK3_REDESIGN_CACHE_DIR=.artifacts/week3-redesign/cache
WEEK3_REDESIGN_WORK_DIR=.artifacts/week3-redesign/work
WEEK3_REDESIGN_PROFILE=big_data_course_content/presentations/week_3_redesign_profile.json

# Fill this with your real key in the local `.env.week3` file, not in the example.
OPENAI_API_KEY=

# Optional when switching providers:
# GEMINI_API_KEY=
